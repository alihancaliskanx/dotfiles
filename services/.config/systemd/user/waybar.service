[Unit]
# Replaces the `while :; do waybar; sleep 2; done` loop both compositor configs
# used to carry. systemd already knows how to restart a process, and this way
# the bar's output lands in the journal instead of nowhere:
#   journalctl --user -u waybar -f
Description=Waybar
Documentation=https://github.com/Alexays/Waybar/wiki
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=waybar
# SIGUSR2 reloads the config; SIGUSR1 (what Mod+Shift+Space sends) hides the bar.
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
