#!/usr/bin/env bash
#
# caelestia-adwaita-colours — say the wallpaper's colours again, in the dialect
# libadwaita still listens to.
#
# caelestia regenerates ~/.config/gtk-4.0/gtk.css on every scheme change, and
# every line of it is an @define-color:
#
#     @define-color window_bg_color #120d0f;
#
# That was libadwaita's override mechanism until 1.6, which replaced the named
# colours with CSS custom properties and left @define-color behind as a
# deprecated alias that no longer feeds them. libadwaita here is 1.9, so the
# file is read, parsed, and has no effect: GTK3 windows recoloured with the
# wallpaper while Nautilus and every other adwaita application stayed the
# default grey. Measured rather than reasoned about — appending a :root block by
# hand turned Nautilus plum on the next launch.
#
# So this appends the same palette a second time under the new names. It is
# bounded by markers, so re-running it replaces its own block rather than
# stacking another one underneath.
#
# It is wired up as theme.postHook, which fires last of all, after apply_gtk has
# written the file. That hook lives in ~/.config/caelestia/cli.json and not in
# shell.json, which is worth saying out loud: the two files belong to the CLI and
# the shell respectively, they take different keys, and a postHook put in the
# wrong one is not an error — it is simply never read. That cost a round here.
#
# GTK3 needs none of this. adw-gtk3 is a GTK3 stylesheet and GTK3 has no custom
# properties at all; @define-color is the only mechanism it has ever had, and it
# is the one that already works.

set -uo pipefail

die() { printf '\e[31m✘ %s\e[0m\n' "$*" >&2; exit 1; }

command -v jq >/dev/null || die "jq is not installed"

CSS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/gtk.css"
SCHEME="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/scheme.json"
BEGIN="/* caelestia-adwaita-colours */"
END="/* end caelestia-adwaita-colours */"

# caelestia puts the palette in the environment for its postHook. The file is
# the fallback, so running this by hand after an upgrade does the same thing.
colours="${SCHEME_COLOURS:-}"
[ -n "$colours" ] || colours=$(jq -c '.colours' "$SCHEME" 2>/dev/null)
[ -n "$colours" ] && [ "$colours" != "null" ] || die "no scheme — neither \$SCHEME_COLOURS nor $SCHEME"

[ -f "$CSS" ] || die "$CSS is not there — has caelestia written it yet?"

# The mapping is caelestia's own, from its gtk.css template, so the two spellings
# of the palette cannot drift apart. The names libadwaita added after the switch
# — dialog, secondary sidebar, thumbnail — follow the same pairs.
block=$(printf '%s' "$colours" | jq -r '
    def c(n): "#" + (.[n] // "");
    [ ":root {",
      "    --accent-color: "                 + c("primary")     + ";",
      "    --accent-bg-color: "              + c("primary")     + ";",
      "    --accent-fg-color: "              + c("onPrimary")   + ";",
      "    --window-bg-color: "              + c("background")  + ";",
      "    --window-fg-color: "              + c("onBackground")+ ";",
      "    --headerbar-bg-color: "           + c("surfaceDim")  + ";",
      "    --headerbar-fg-color: "           + c("onSurface")   + ";",
      "    --popover-bg-color: "             + c("surfaceDim")  + ";",
      "    --popover-fg-color: "             + c("onSurface")   + ";",
      "    --dialog-bg-color: "              + c("surfaceDim")  + ";",
      "    --dialog-fg-color: "              + c("onSurface")   + ";",
      "    --view-bg-color: "                + c("surface")     + ";",
      "    --view-fg-color: "                + c("onSurface")   + ";",
      "    --card-bg-color: "                + c("surface")     + ";",
      "    --card-fg-color: "                + c("onSurface")   + ";",
      "    --thumbnail-bg-color: "           + c("surface")     + ";",
      "    --thumbnail-fg-color: "           + c("onSurface")   + ";",
      "    --sidebar-bg-color: "             + c("background")  + ";",
      "    --sidebar-fg-color: "             + c("onBackground")+ ";",
      "    --sidebar-backdrop-color: "       + c("background")  + ";",
      "    --sidebar-border-color: "         + c("background")  + ";",
      "    --secondary-sidebar-bg-color: "   + c("background")  + ";",
      "    --secondary-sidebar-fg-color: "   + c("onBackground")+ ";",
      "    --secondary-sidebar-backdrop-color: " + c("background") + ";",
      "    --secondary-sidebar-border-color: "   + c("background") + ";",
      "    --destructive-color: "            + c("error")       + ";",
      "    --destructive-bg-color: "         + c("error")       + ";",
      "    --destructive-fg-color: "         + c("onError")     + ";",
      "    --success-color: "                + c("success")     + ";",
      "    --success-bg-color: "             + c("success")     + ";",
      "    --success-fg-color: "             + c("onSuccess")   + ";",
      "    --error-color: "                  + c("error")       + ";",
      "    --error-bg-color: "               + c("error")       + ";",
      "    --error-fg-color: "               + c("onError")     + ";",
      "}"
    ] | join("\n")')

[ -n "$block" ] || die "could not build the palette out of the scheme"

# Rewritten rather than edited in place: caelestia writes this file atomically
# and a half-written gtk.css is a window with no colours at all.
tmp=$(mktemp "$CSS.XXXXXX") || die "cannot write next to $CSS"
trap 'rm -f "$tmp"' EXIT

awk -v b="$BEGIN" -v e="$END" '
    $0 == b { skip = 1 }
    !skip   { print }
    $0 == e { skip = 0 }
' "$CSS" > "$tmp"

{
    printf '\n%s\n' "$BEGIN"
    printf '%s\n' "$block"
    printf '%s\n' "$END"
} >> "$tmp"

chmod --reference="$CSS" "$tmp" 2>/dev/null
mv "$tmp" "$CSS"
trap - EXIT
