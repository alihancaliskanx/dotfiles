#!/usr/bin/env bash
#
# caelestia-shell-overlay — a writable copy of caelestia's shell that is almost
# entirely not a copy.
#
# The shell ships as QML under /etc/xdg/quickshell/caelestia, owned by pacman.
# Some of its behaviour is not configurable and can only be changed by editing
# that QML — the launcher not closing when the pointer leaves it, for one. The
# obvious answer is to fork the whole tree into ~/.config/quickshell/caelestia,
# which quickshell prefers over /etc/xdg. That is 283 files and 12 MB to re-merge
# by hand on every upstream release, for two changed lines.
#
# There is a much cheaper way, and it rests on one fact worth stating plainly
# because the whole design depends on it: quickshell resolves the `qs.` import
# prefix against the *config root directory*, not against wherever shell.qml
# actually lives. A symlinked shell.qml still loads `qs.modules.…` out of the
# directory the symlink sits in. So the overlay can be a mirror of symlinks with
# real files punched through it only where we patch something, and the other 282
# files keep tracking the package.
#
# What is real and what is a link follows from the patches: every directory on
# the way down to a patched file has to be a real directory, everything else is
# one symlink. With a single patch under modules/drawers that is 29 symlinks,
# two real directories and one real file.
#
# Patches, not patched copies. A stored copy of an upstream file goes stale in
# silence — it keeps working while quietly being an old version. A .patch either
# applies or fails, and a failure is the signal that upstream moved and the
# change needs looking at again.
#
# THE ONE THING TO KNOW: this must be re-run after every caelestia-shell upgrade.
# A release that adds a file leaves the overlay without it, and a missing import
# is a shell that does not start. --restart-if-changed makes the session heal
# itself: it is run at login, notices the package moved, rebuilds and restarts
# the shell before anyone looks at the screen.

set -uo pipefail

SRC="${CAELESTIA_SHELL_SRC:-/etc/xdg/quickshell/caelestia}"
DST="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/caelestia"
PATCHES="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia/shell-patches"
MARKER=".generated-by-caelestia-shell-overlay"

RED=$'\e[31m'; YLW=$'\e[33m'; GRN=$'\e[32m'; DIM=$'\e[2m'; RST=$'\e[0m'
die()  { printf '%s✘ %s%s\n' "$RED" "$*" "$RST" >&2; exit 1; }
warn() { printf '%s! %s%s\n' "$YLW" "$*" "$RST" >&2; }
ok()   { [ "$QUIET" -eq 1 ] || printf '%s✔%s %s\n' "$GRN" "$RST" "$*"; }
dim()  { [ "$QUIET" -eq 1 ] || printf '%s%s%s\n' "$DIM" "$*" "$RST"; }

QUIET=0
RESTART=0
for arg in "$@"; do
    case "$arg" in
        -q|--quiet)              QUIET=1 ;;
        --restart-if-changed)    RESTART=1; QUIET=1 ;;
        -h|--help)
            sed -n '2,36p' "$0" | sed 's/^# \{0,1\}//'
            printf '\nUsage: %s [--quiet] [--restart-if-changed]\n' "${0##*/}"
            exit 0 ;;
        *) die "unknown argument: $arg" ;;
    esac
done

[ -d "$SRC" ] || die "$SRC is not there — is caelestia-shell installed?"
command -v patch >/dev/null || die "patch is not installed"

# Refuse to touch a directory this script did not create. Somebody may have
# forked the shell here by hand, and a fork is hours of work to lose to a tool
# that assumed it owned the path.
if [ -e "$DST" ] && [ ! -e "$DST/$MARKER" ]; then
    die "$DST exists and was not made by this script — move it aside first"
fi

# Relative paths of the files we patch, derived from the patch tree: every
# <relpath>.patch under $PATCHES patches <relpath> in the shell.
patched=()
if [ -d "$PATCHES" ]; then
    while IFS= read -r p; do
        rel="${p#"$PATCHES"/}"
        patched+=("${rel%.patch}")
    # -L, because the patches arrive as symlinks out of the dotfiles repo and a
    # bare -type f does not consider a symlink to be a file.
    done < <(find -L "$PATCHES" -type f -name '*.patch' | sort)
fi

# Directories that therefore have to be real rather than symlinked: every
# ancestor of every patched file.
declare -A real_dir=()
for rel in "${patched[@]+"${patched[@]}"}"; do
    [ -f "$SRC/$rel" ] || die "patch for $rel, but the shell has no such file"
    d="$(dirname "$rel")"
    while [ "$d" != "." ] && [ "$d" != "/" ]; do
        real_dir["$d"]=1
        d="$(dirname "$d")"
    done
done

# Built beside the target and swapped in, so a failure half way through leaves
# the working overlay alone rather than a directory of holes.
TMP="$(mktemp -d "${DST%/*}/.caelestia-overlay.XXXXXX")" || die "cannot create a temp dir next to $DST"
trap 'rm -rf "$TMP"' EXIT

mirror() {
    local rel="$1" src dst entry
    src="$SRC${rel:+/$rel}"
    dst="$TMP${rel:+/$rel}"
    mkdir -p "$dst"
    for entry in "$src"/* "$src"/.[!.]*; do
        [ -e "$entry" ] || continue
        local name="${entry##*/}"
        local child="${rel:+$rel/}$name"
        if [ -d "$entry" ] && [ -n "${real_dir[$child]:-}" ]; then
            mirror "$child"
        else
            ln -s "$entry" "$dst/$name"
        fi
    done
}
mirror ""

# Punch the patched files through the mirror.
rc=0
for rel in "${patched[@]+"${patched[@]}"}"; do
    rm -f "$TMP/$rel"
    cp "$SRC/$rel" "$TMP/$rel"
    chmod u+w "$TMP/$rel"
    if patch --silent --forward --strip=0 "$TMP/$rel" < "$PATCHES/$rel.patch"; then
        ok "patched  $rel"
    else
        # Leave the unpatched upstream file: a shell that starts and behaves like
        # the package is a far better failure than a shell that does not start.
        rm -f "$TMP/$rel"
        ln -s "$SRC/$rel" "$TMP/$rel"
        warn "$rel: patch did not apply — upstream moved, the change needs redoing"
        rc=1
    fi
    rm -f "$TMP/$rel.orig" "$TMP/$rel.rej"
done

# A manifest of what the overlay is made of, so the next run can tell whether
# anything actually moved without comparing 283 files.
#
# The checksums of the patched files are part of it, and have to be: the paths
# alone do not change when a .patch is edited, so an overlay compared on paths
# only would report itself current and throw the newly patched content away.
# That is not hypothetical — it is what happened the first time a patch grew.
{
    find "$TMP" -mindepth 1 -printf '%P\t%y\t%l\n' | sort
    for rel in "${patched[@]+"${patched[@]}"}"; do
        [ -f "$TMP/$rel" ] && [ ! -L "$TMP/$rel" ] || continue
        printf '%s\t%s\n' "$rel" "$(sha256sum < "$TMP/$rel" | cut -d' ' -f1)"
    done
} > "$TMP/$MARKER"

changed=1
if [ -f "$DST/$MARKER" ] && cmp -s "$TMP/$MARKER" "$DST/$MARKER"; then
    changed=0
fi

if [ "$changed" -eq 1 ]; then
    rm -rf "$DST"
    mkdir -p "${DST%/*}"
    mv "$TMP" "$DST"
    trap - EXIT
    ok "overlay rebuilt  $(find "$DST" -mindepth 1 -type l | wc -l) links, ${#patched[@]} patched"
    dim "$DST"
else
    dim "overlay already current"
fi

if [ "$RESTART" -eq 1 ] && [ "$changed" -eq 1 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    # Only when something moved, and only in a running session. caelestia starts
    # its own shell from execs.lua before this can run, so on the login where the
    # package changed the shell is already up on the old overlay; restarting it
    # is what makes the session self-healing instead of needing a second login.
    # `caelestia shell -k` does not reliably kill it and `-d` will then happily
    # start a second one — two shells, two bars, twelve layers on one screen.
    # `qs kill` addresses the instance by config name and does the job.
    qs kill -c caelestia >/dev/null 2>&1
    sleep 1
    caelestia shell -d >/dev/null 2>&1 &
fi

exit "$rc"
