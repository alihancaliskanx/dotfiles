#!/usr/bin/env bash
#
# special-close — close whichever special workspace is showing.
#
# The keys that open them are toggles, so the same key closes again: SUPER+S,
# SUPER+M, SUPER+D, SUPER+R. That is fine when you remember which one you are
# looking at and less fine when you do not, which is the whole reason to have
# one key that means "put this away" regardless.
#
# Hyprland has no dispatcher for it. togglespecialworkspace needs the name, and
# with no argument it toggles the one literally called "special" rather than the
# one on screen. So the name is read back off the focused monitor first.
#
# caelestia runs Hyprland's lua config provider, and under it the dispatch IPC
# parses its argument as Lua — `togglespecialworkspace music` is a syntax error
# there, not a command. Hence hyprctl eval and hl.dsp rather than the plain
# string form. This script ships with the caelestia rice, so lua is a given.

set -uo pipefail

die() { printf '\e[31m✘ %s\e[0m\n' "$*" >&2; exit 1; }

command -v hyprctl >/dev/null || die "hyprctl not found"
command -v jq      >/dev/null || die "jq is not installed"

ws="$(hyprctl monitors -j | jq -r 'map(select(.focused)) | .[0].specialWorkspace.name // ""')"

# Nothing showing: not an error, just nothing to do. The key should be safe to
# press at any time.
[ -n "$ws" ] && [ "$ws" != "null" ] || exit 0

hyprctl eval "hl.dispatch(hl.dsp.workspace.toggle_special(\"${ws#special:}\"))" >/dev/null
