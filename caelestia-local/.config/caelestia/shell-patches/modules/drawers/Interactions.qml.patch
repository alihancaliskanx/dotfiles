+    // Which panel is pinned, if any. Deliberately NOT one of the
+    // *ShortcutActive flags: those mean "opened by shortcut" and are cleared
+    // the moment the pointer touches the panel, which is upstream handing
+    // control back to hover. Pinning has to survive exactly that — you pin
+    // the thing you are pointing at — so it needs a flag hover never touches.
+    property string pinnedPanel: ""
     property bool osdShortcutActive
     property bool utilitiesShortcutActive
 
+    // ─── pinning ─────────────────────────────────────────────────────────────
+    // The hover panels close the moment the pointer leaves, which is right up
+    // until you want to read one. Nothing new has to be taught to the close
+    // paths to fix that: the *ShortcutActive flags already mean "this was not
+    // opened by hover, so hover does not get to close it". Pinning is setting
+    // that flag on whatever the pointer happens to be over.
+    //
+    // Only the panels that have such a flag can be pinned. The bar and the
+    // sidebar close through other paths and would need their own.
+    function pinnedAny(): bool {
+        return pinnedPanel !== "";
+    }
+
+    function unpinAll(): void {
+        pinnedPanel = "";
+    }
+
+    function pinHovered(): void {
+        const x = root.mouseX;
+        const y = root.mouseY;
+
+        if (inTopPanel(panels.dashboard, x, y))
+            pinnedPanel = "dashboard";
+        else if (inRightPanel(panels.osdWrapper, x, y))
+            pinnedPanel = "osd";
+        else if (inBottomPanel(panels.utilities, x, y, true))
+            pinnedPanel = "utilities";
+        else if (inBottomPanel(panels.launcher, x, y))
+            pinnedPanel = "launcher";
+    }
+
+    IpcHandler {
+        // One key both pins and lets go: pinning something while something else
+        // is already pinned would leave two panels stuck open with only one key
+        // to clear them.
+        function toggle(): void {
+            if (root.pinnedAny())
+                root.unpinAll();
+            else
+                root.pinHovered();
+        }
+
+        function pin(): void {
+            root.pinHovered();
+        }
+
+        function unpin(): void {
+            root.unpinAll();
+        }
+
+        target: "pin"
+    }
