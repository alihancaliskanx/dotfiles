{
    "appearance": {
        "anim": {
            "durations": {
                "scale": 0.6
            }
        },
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "showOnHover": false
        },
        "clock": {
            "background": false,
            "showDate": false
        },
        "dragThreshold": 20,
        "persistent": true,
        "popouts": {
            "activeWindow": false
        },
        "showOnHover": true,
        "workspaces": {
            "activeTrail": false
        }
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ]
        }
    },
    "launcher": {
        "enableDangerousActions": true,
        "maxShown": 6,
        "maxWallpapers": 20,
        "showOnHover": true,
        "useFuzzy": {
            "actions": true,
            "apps": true,
            "schemes": true,
            "variants": true,
            "wallpapers": true
        },
        "vimKeybinds": true
    },
    "services": {
        "maxVolume": 1.5
    },
    "sidebar": {
        "enabled": true
    }
}
