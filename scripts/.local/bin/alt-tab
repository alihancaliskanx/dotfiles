#!/usr/bin/env bash
#
# alt-tab — most-recently-used window cycling, the way Windows and KDE do it,
# with no switcher UI.
#
#   alt-tab          one step back through the MRU order
#   alt-tab prev     the other way
#
# THE TRICK: the order is frozen on the first press and walked on the ones that
# follow. Focusing a window makes it the most recent, so without freezing, the
# second press would come straight back and Alt+Tab would be a two-window
# toggle — which is exactly what it was before this script. A cycle ends when no
# press arrives for RESET_MS, and the next press re-reads the live order.
#
# Both compositors already track the focus order, so nothing has to be recorded
# here: niri exposes focus_timestamp per window, Hyprland focusHistoryID.

set -uo pipefail

RESET_MS=1200
# Which windows take part: the current workspace, like KDE's default, or every
# window everywhere. ALT_TAB_SCOPE=all overrides it without editing this file.
SCOPE="${ALT_TAB_SCOPE:-workspace}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/alt-tab.state"

die() { printf '\e[31m✘ %s\e[0m\n' "$*" >&2; exit 1; }
command -v jq >/dev/null || die "jq is not installed"

# Ids in MRU order, most recent first. Windows that were never focused carry no
# timestamp in niri; they go last instead of breaking the sort.
mru_ids() {
    case "${XDG_CURRENT_DESKTOP:-}" in
      *niri*)
        local ws=""
        # From the workspace, not from the focused window: while a layer-shell
        # surface holds the keyboard (fuzzel, the bar) no window is focused at
        # all, and asking the window would silently widen the cycle to every
        # workspace.
        [ "$SCOPE" = workspace ] && ws=$(niri msg -j workspaces | jq -r '.[] | select(.is_active) | .id' | head -1)
        niri msg -j windows | jq -r --arg ws "$ws" '
            [ .[] | select($ws == "" or (.workspace_id | tostring) == $ws) ]
            | (map(select(.focus_timestamp != null))
               | sort_by(-(.focus_timestamp.secs * 1000000000 + .focus_timestamp.nanos)))
              + map(select(.focus_timestamp == null))
            | .[].id'
        ;;
      *Hyprland*)
        local ws=""
        # activeworkspace, not activewindow: the latter is an empty object when
        # nothing is focused, and the cycle would quietly cover every workspace.
        [ "$SCOPE" = workspace ] && ws=$(hyprctl -j activeworkspace | jq -r '.id')
        hyprctl -j clients | jq -r --arg ws "$ws" '
            [ .[] | select(.mapped and (.title != "")) ]
            | [ .[] | select($ws == "" or (.workspace.id | tostring) == $ws) ]
            | sort_by(.focusHistoryID)
            | .[].address'
        ;;
      *)
        die "unsupported session: ${XDG_CURRENT_DESKTOP:-unset} (Hyprland or niri)"
        ;;
    esac
}

focus_id() {
    case "${XDG_CURRENT_DESKTOP:-}" in
      *niri*)     niri msg action focus-window --id "$1" >/dev/null ;;
      *Hyprland*) hyprctl --batch "dispatch focuswindow address:$1; dispatch bringactivetotop" >/dev/null ;;
    esac
}

step=1
[ "${1:-next}" = prev ] && step=-1

# Both separators: LC_NUMERIC is tr_TR here, so EPOCHREALTIME comes with a
# comma, and stripping only the dot leaves a comma that turns the arithmetic
# into a comma operator — the whole timestamp silently became three digits.
now_ms=$(( ${EPOCHREALTIME//[.,]/} / 1000 ))
last_ms=0; idx=0; ids=""
# shellcheck disable=SC1090
[ -f "$STATE" ] && . "$STATE"

if [ $(( now_ms - last_ms )) -gt "$RESET_MS" ]; then
    ids="$(mru_ids | tr '\n' ' ')"
    idx=0
fi

read -ra order <<< "$ids"
n=${#order[@]}
[ "$n" -gt 1 ] || exit 0          # nothing to cycle between

idx=$(( (idx + step) % n ))
[ "$idx" -lt 0 ] && idx=$(( idx + n ))

focus_id "${order[idx]}"

printf 'last_ms=%s\nidx=%s\nids="%s"\n' "$now_ms" "$idx" "$ids" > "$STATE"
