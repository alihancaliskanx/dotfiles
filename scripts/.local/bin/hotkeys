#!/usr/bin/env bash
#
# hotkeys — the keys this session actually has, in fuzzel.
#
# WHERE THE LIST COMES FROM. Under niri it is the config file: `binds { … }` is
# a flat list of key-to-action lines and reading it back is honest. Under
# Hyprland this used to be the same idea — grep `bind = ` out of
# ~/.config/hypr/hyprland.conf — and it stops being true the moment anything
# hands Hyprland a Lua config instead. That provider is a program, not a list:
# the binds are made by hl.bind() calls spread over a dozen required files, out
# of variables and loops, and the hyprland.conf sitting beside them is the stub
# Hyprland writes when it is not the config in use. The old branch read that
# stub and showed its six autogenerated example binds.
#
# So the Hyprland branch asks the compositor instead. `hyprctl binds` is the
# list Hyprland is actually holding, whichever provider built it, which also
# means $mod is already resolved to SUPER and a bind added at runtime is in it.
#
# WHAT A BIND CAN SAY ABOUT ITSELF. A conf bind carries its dispatcher and its
# arguments — `exec kitty`, `movefocus l` — and that is a description already. A
# Lua bind carries neither: its dispatcher is `__lua` and its argument is the
# index of a function in a table, so `__lua 207` is the whole of what there is
# to print. The way out is the description a bind may be given — bindd in the
# conf, description = in Lua — and these dotfiles put one on every bind of their
# own.
#
# Which is why the Hyprland list is the binds that say what they do, and why the
# prompt counts the ones that did not. They are not hidden, they are unlabelled,
# and there is nothing this script could print for them that would be worth
# reading.

set -uo pipefail

die() { printf '\e[31m✘ %s\e[0m\n' "$*" >&2; exit 1; }

command -v fuzzel >/dev/null || die "fuzzel is not installed"

prompt="Keys "

case "${XDG_CURRENT_DESKTOP:-}" in
  *niri*)
    list=$(sed -n '/^binds {/,/^}/p' "$HOME/.config/niri/config.kdl" \
      | sed -nE 's/^    ([A-Za-z][A-Za-z0-9+_]*)( +[a-z-]+=[^ {]+)* +\{ (.*); \}$/\1\t\3/p' \
      | awk -F'\t' '{ gsub(/\\"/, "\"", $2); printf "%-26s %s\n", $1, $2 }')
    ;;
  *Hyprland*)
    command -v hyprctl >/dev/null || die "hyprctl not found"
    command -v jq      >/dev/null || die "jq is not installed"

    binds=$(hyprctl binds -j) || die "hyprctl binds failed"

    # Hyprland reports the modifiers as the X11 mask it matches on, so the names
    # come back out of the bits: SHIFT 1, CTRL 4, ALT 8, SUPER 64. jq has no
    # bitwise operators, hence dividing down and taking the parity. The order is
    # the one the configs write them in, not the numeric one.
    list=$(jq -r '
        def bit($m; $n): ($m / $n | floor) % 2 == 1;
        .[]
        | (if (.description // "") != "" then .description
           elif .dispatcher == "__lua" then empty
           else .dispatcher + (if (.arg // "") != "" then " " + .arg else "" end)
           end) as $what
        | ([ (if bit(.modmask; 64) then "SUPER" else empty end),
             (if bit(.modmask; 4)  then "CTRL"  else empty end),
             (if bit(.modmask; 8)  then "ALT"   else empty end),
             (if bit(.modmask; 1)  then "SHIFT" else empty end),
             (if (.key // "") != "" then .key
              else "code:" + (.keycode | tostring) end)
           ] | join("+")) as $keys
        | [$keys, $what] | @tsv' <<< "$binds" \
      | awk -F'\t' '{ printf "%-26s %s\n", $1, $2 }')

    # Said out loud rather than quietly showing a fifth of what is bound.
    total=$(jq 'length' <<< "$binds")
    shown=$(printf '%s' "$list" | grep -c '^')      # 0 on an empty list
    [ "$shown" -lt "$total" ] && prompt="Keys ($shown of $total) "
    ;;
  *)
    die "unsupported session: ${XDG_CURRENT_DESKTOP:-unset} (Hyprland or niri)"
    ;;
esac

printf '%s\n' "$list" | fuzzel --dmenu --prompt "$prompt" --width 78 --lines 20 >/dev/null || true
