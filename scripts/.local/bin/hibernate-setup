#!/usr/bin/env bash
#
# hibernate-setup — gives this machine somewhere to hibernate to.
#
# Suspend keeps RAM powered: instant wake, and the battery still drains. Hibernate
# writes RAM to disk and cuts power entirely, then restores it at the next boot.
# logind refuses it here — `CanHibernate` answers "na" — for two reasons, and both
# are addressed below.
#
# THE FIRST IS ZRAM. The only swap on this machine is /dev/zram0, and zram is a
# compressed block device that lives *in RAM*. Writing RAM into it and then
# cutting power leaves nothing to come back to. zram is genuinely good at what it
# is for and is left alone: it keeps priority 100 and stays the swap everything
# normally pages to. The swapfile this creates sits at priority -2, so it is only
# touched when zram is full or when the kernel is hibernating into it.
#
# THE SECOND IS THAT NOBODY TOLD THE KERNEL WHERE TO LOOK. Restoring happens
# before any filesystem is mounted, so the location has to be on the kernel
# command line: `resume=` for the filesystem and `resume_offset=` for where in it
# the swapfile physically starts. Neither is there now.
#
# BTRFS MAKES THIS FUSSIER THAN IT SOUNDS. A swapfile must not be copy-on-write,
# must not be compressed, and must not move — which is exactly what snapshots and
# defragmentation do to a file. `btrfs filesystem mkswapfile` handles the first
# two, and the third is why the file goes in a subvolume of its own: a btrfs
# snapshot is not recursive, so a nested subvolume is invisible to the snapshots
# snapper takes of @, and the swapfile cannot be caught in one.
#
#   hibernate-setup               set it up (32 GiB by default)
#   hibernate-setup -n            show what it would do, touch nothing (still asks for sudo)
#   hibernate-setup --revert      take resume= back out of GRUB, keep the swapfile
#   hibernate-setup --fix-nvidia  clear the module option that blocks resume
#   SIZE=20 hibernate-setup       a different size, in GiB
#
# No `sudo` in front: it re-runs itself under sudo by absolute path, the way
# plasmalogin-theme does. `sudo hibernate-setup` is in fact the one form that
# does NOT work — sudo replaces PATH with secure_path, which has no ~/.local/bin
# in it, so the shell never finds the script at all.
#
# Run once per machine. Idempotent: anything already in place is left alone, so a
# second run is a check rather than a change. A reboot is needed at the end,
# because the kernel command line is only read at boot.

set -uo pipefail

# Resolved through the symlink, because ~/.local/bin/hibernate-setup points into
# the repo and sudo has to be handed a path it can still find.
SELF="$(readlink -f "$0")"
ARGV=("$@")

SIZE="${SIZE:-32}"
SUBVOL="${SUBVOL:-/swap}"
SWAPFILE="$SUBVOL/swapfile"
DRY=0

RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'; CYN=$'\e[36m'; DIM=$'\e[2m'; RST=$'\e[0m'
die()  { printf '%s✘ %s%s\n' "$RED" "$*" "$RST" >&2; exit 1; }
warn() { printf '%s! %s%s\n' "$YLW" "$*" "$RST" >&2; }
ok()   { printf '%s✔%s %s\n' "$GRN" "$RST" "$*"; }
dim()  { printf '%s  %s%s\n' "$DIM" "$*" "$RST"; }
run()  { if [ "$DRY" -eq 1 ]; then dim "would: $*"; else "$@"; fi; }

usage() { awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "${BASH_SOURCE[0]}"; }

REVERT=0
FIXNV=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -n|--dry-run) DRY=1 ;;
        --revert)     REVERT=1 ;;
        --fix-nvidia) FIXNV=1 ;;
        -h|--help)    usage; exit 0 ;;
        *)            die "unknown option: $1" ;;
    esac
    shift
done

# Elevate rather than telling you to, and before anything is printed — otherwise
# the banner comes out once here and again in the elevated run. Through `env`
# rather than sudo's own VAR=value, so SIZE and SUBVOL survive whatever
# env_reset policy is in force.
#
# A dry run elevates too, and has to: /swap is root-owned, so without it the
# preview cannot see the subvolume or the swapfile and reports the wrong thing.
# It still writes nothing.
if [ "$(id -u)" -ne 0 ]; then
    command -v sudo >/dev/null || die "needs root, and there is no sudo here"
    exec sudo -- env "SIZE=$SIZE" "SUBVOL=$SUBVOL" "$SELF" ${ARGV[@]+"${ARGV[@]}"}
fi

printf '%sHibernate setup%s\n\n' "$CYN" "$RST"
[ "$DRY" -eq 1 ] && printf '%s(dry-run — nothing will change)%s\n\n' "$DIM" "$RST"

# ─── --revert ────────────────────────────────────────────────────────────────
# Disarms hibernation without undoing any of the rest: the swapfile stays and
# goes on being swap, only the kernel's instruction to resume from it is taken
# away. For when resume is known not to work and the next reboot should not try.
# ─── --fix-nvidia ────────────────────────────────────────────────────────────
# Shadows gpu-screen-recorder's module option with one that says the opposite.
# A file in /etc/modprobe.d hides the file of the same name in /usr/lib, so this
# replaces gsr-nvidia.conf outright rather than fighting it — and it survives
# the package being updated, which editing /usr/lib would not.
#
# What is given up: gpu-screen-recorder set it so that video memory survives a
# suspend while recording. The open kernel modules preserve it anyway through
# NVreg_UseKernelSuspendNotifiers=1, which nvidia-sleep.conf already sets, so
# the setting is redundant here and costs a working resume.
if [ "$FIXNV" -eq 1 ]; then
    TARGET=/etc/modprobe.d/gsr-nvidia.conf
    if [ -f "$TARGET" ]; then
        dim "$TARGET already exists:"
        dim "$(cat "$TARGET")"
        run cp -a "$TARGET" "$TARGET.bak.$(date +%Y%m%d-%H%M%S)"
    fi
    if [ "$DRY" -eq 1 ]; then
        dim "would write $TARGET:"
        dim "  options nvidia NVreg_PreserveVideoMemoryAllocations=0"
        dim "would run: mkinitcpio -P"
        exit 0
    fi
    printf 'options nvidia NVreg_PreserveVideoMemoryAllocations=0\n' > "$TARGET" \
        || die "could not write $TARGET"
    ok "wrote $TARGET"

    # Read back through modprobe rather than trusting the write: the point is
    # what modprobe resolves after precedence, not what is in one file.
    if modprobe --showconfig 2>/dev/null \
        | grep -E '^options[[:space:]]+nvidia[[:space:]].*NVreg_PreserveVideoMemoryAllocations=1([[:space:]]|$)' \
        >/dev/null; then
        die "something still sets PreserveVideoMemoryAllocations=1 — check modprobe --showconfig"
    fi
    ok "modprobe no longer resolves PreserveVideoMemoryAllocations=1"

    command -v mkinitcpio >/dev/null || die "mkinitcpio not found"
    dim "rebuilding the initramfs, this takes a moment"
    mkinitcpio -P >/dev/null 2>&1 || die "mkinitcpio -P failed"
    ok "initramfs rebuilt"
    printf '\n'
    dim "reboot, then hibernate is worth trying again:"
    dim "  systemctl hibernate"
    exit 0
fi

if [ "$REVERT" -eq 1 ]; then
    GRUBDEF=/etc/default/grub
    [ -f "$GRUBDEF" ] || die "no $GRUBDEF"
    if ! grep -q 'resume=' "$GRUBDEF"; then
        ok "no resume= in $GRUBDEF — nothing to take out"
        exit 0
    fi
    run cp -a "$GRUBDEF" "$GRUBDEF.bak.$(date +%Y%m%d-%H%M%S)"
    if [ "$DRY" -eq 1 ]; then
        dim "would strip resume= and resume_offset= from $GRUBDEF"
        dim "would regenerate /boot/grub/grub.cfg"
        exit 0
    fi
    sed -i -E 's/ ?resume=[^ "'"'"']*//g; s/ ?resume_offset=[0-9]*//g' "$GRUBDEF"
    grep -q 'resume=' "$GRUBDEF" && die "resume= is still in $GRUBDEF — take it out by hand"
    ok "stripped resume= from $GRUBDEF"
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || die "grub-mkconfig failed"
    ok "regenerated /boot/grub/grub.cfg"
    dim "the swapfile is untouched and still swap; hibernation is simply not armed"
    exit 0
fi

# ─── refuse anything this script was not written for ─────────────────────────
FSTYPE="$(findmnt -no FSTYPE /)"
[ "$FSTYPE" = btrfs ] || die "/ is $FSTYPE, and this script only knows btrfs"

# A swapfile cannot live on a multi-device btrfs: the kernel needs one physical
# offset and there is no such thing across two disks.
devs="$(findmnt -no SOURCE / | sed 's/\[.*//')"
[ "$(btrfs filesystem show / 2>/dev/null | grep -c 'devid ')" -le 1 ] \
    || die "this btrfs spans more than one device; a swapfile cannot be resumed from it"

UUID="$(findmnt -no UUID /)"
[ -n "$UUID" ] || die "could not read the filesystem UUID of /"

RAM_KB="$(awk '/^MemTotal:/{print $2}' /proc/meminfo)"
RAM_GB=$(( (RAM_KB + 1048575) / 1048576 ))
if [ "$SIZE" -lt "$RAM_GB" ]; then
    die "swap of ${SIZE}G is smaller than ${RAM_GB}G of RAM — hibernation needs at least as much"
fi

AVAIL_GB="$(findmnt -nbo AVAIL / | awk '{printf "%d", $1/1073741824}')"
[ "$AVAIL_GB" -gt $(( SIZE + 10 )) ] \
    || die "only ${AVAIL_GB}G free on /; ${SIZE}G swap plus headroom will not fit"

dim "filesystem  btrfs on $devs  (UUID $UUID)"
dim "RAM         ${RAM_GB}G"
dim "swapfile    $SWAPFILE  ${SIZE}G"
dim "free        ${AVAIL_GB}G"
printf '\n'

# ─── the subvolume ───────────────────────────────────────────────────────────
if btrfs subvolume show "$SUBVOL" >/dev/null 2>&1; then
    ok "$SUBVOL is already a subvolume"
elif [ -e "$SUBVOL" ]; then
    die "$SUBVOL exists and is not a btrfs subvolume — move it aside first"
else
    run btrfs subvolume create "$SUBVOL" || die "could not create $SUBVOL"
    ok "created the subvolume $SUBVOL"
fi
run chmod 700 "$SUBVOL"

# ─── the swapfile ────────────────────────────────────────────────────────────
if [ -f "$SWAPFILE" ]; then
    have=$(( $(stat -c %s "$SWAPFILE" 2>/dev/null || echo 0) / 1073741824 ))
    if [ "$have" -ge "$RAM_GB" ]; then
        ok "$SWAPFILE already exists (${have}G)"
    else
        die "$SWAPFILE is only ${have}G, smaller than ${RAM_GB}G of RAM — remove it and re-run"
    fi
else
    # mkswapfile sets NOCOW and no-compression itself, which is the whole reason
    # to use it rather than fallocate + mkswap. --uuid clear keeps a restored
    # image from colliding with a previous one.
    run btrfs filesystem mkswapfile --size "${SIZE}g" --uuid clear "$SWAPFILE" \
        || die "mkswapfile failed"
    ok "created $SWAPFILE (${SIZE}G, nocow, uncompressed)"
fi

# ─── fstab ───────────────────────────────────────────────────────────────────
# pri=-2 puts it below zram's 100, so nothing pages here while zram has room.
FSTAB_LINE="$SWAPFILE none swap defaults,pri=-2 0 0"
if grep -qF "$SWAPFILE" /etc/fstab 2>/dev/null; then
    ok "already in /etc/fstab"
else
    run cp -a /etc/fstab "/etc/fstab.bak.$(date +%Y%m%d-%H%M%S)"
    if [ "$DRY" -eq 1 ]; then
        dim "would append to /etc/fstab: $FSTAB_LINE"
    else
        printf '\n# hibernation target — see hibernate-setup\n%s\n' "$FSTAB_LINE" >> /etc/fstab
    fi
    ok "added to /etc/fstab"
fi

if ! swapon --show=NAME --noheadings 2>/dev/null | grep -qF "$SWAPFILE"; then
    run swapon "$SWAPFILE" || warn "could not swapon $SWAPFILE now; it will come up at boot"
fi

# ─── how many pieces the file is in ──────────────────────────────────────────
# Nothing to enforce here, and that is worth writing down, because the opposite
# is folklore. A swapfile in several extents resumes perfectly well.
#
# Only the *first* block of the file has to be findable without a filesystem,
# and that block is what resume_offset points at. Everything after it is reached
# through the swap map the kernel builds at swapon time, which holds absolute
# device sectors; the image is both written and read back through that map, so
# where the rest of the file physically lives is invisible to resume.
#
# Measured on this machine rather than assumed. A swapfile in four extents,
# spread across 164G of the device, took a 5.5G image and gave every page back:
#
#   Adding 20971516k swap on /swap/swapfile.  Priority:-1 extents:4 across:171966464k
#   PM: Image loading progress: 100%
#   PM: hibernation: Read 5731456 kbytes in 2.67 seconds (2146.61 MB/s)
#   PM: Image successfully loaded
#
# The resume failed anyway, one step later and for an unrelated reason — see the
# nvidia check below. Rebuilding the swapfile would have fixed nothing.
if [ -f "$SWAPFILE" ] && command -v filefrag >/dev/null; then
    EXTENTS="$(filefrag "$SWAPFILE" 2>/dev/null | sed -nE 's/.*: ([0-9]+) extents? found.*/\1/p')"
    [ -n "$EXTENTS" ] && dim "extents     $EXTENTS  (any number resumes)"
fi

# ─── whatever the initramfs loads has to agree to be frozen ──────────────────
# Resuming happens before the real root is mounted: the boot kernel reads the
# image, then freezes every device it has bound so that nothing writes to memory
# while the image is copied over the top of it. A driver that refuses to freeze
# aborts the whole resume, after the image has already been read, and the
# session is gone.
#
# The nvidia module refuses, if it was told to preserve video memory.
# NVreg_PreserveVideoMemoryAllocations=1 is a *proprietary*-driver setting: it
# makes the driver insist on being suspended through /proc/driver/nvidia/suspend
# by nvidia-suspend.service and friends, and no such service exists inside an
# initramfs. The open kernel modules do not want it — NVreg_UseKernelSuspendNotifiers=1
# already preserves video memory for them, which is what the driver README says
# — so having both set is simply a contradiction. gpu-screen-recorder ships the
# first one, in /usr/lib/modprobe.d/gsr-nvidia.conf, without knowing about the
# second.
#
# It only bites on the way back up. Hibernating works, because the kernel's
# PM_HIBERNATION_PREPARE notification reaches the driver; restoring sends
# PM_RESTORE_PREPARE instead, the driver does not take that as permission, and:
#
#   NVRM: GPU 0000:01:00.0: PreserveVideoMemoryAllocations module parameter is set.
#         System Power Management attempted without driver procfs suspend interface.
#   nvidia 0000:01:00.0: PM: pci_pm_freeze(): nv_pmops_freeze [nvidia] returns -5
#   PM: hibernation: Failed to load image, recovering.
#   PM: hibernation: resume failed (-5)
#
# Both halves have to be true to break: nvidia loaded early, and video memory
# preservation asked for. Machines without an nvidia card never reach this.
NV_EARLY=0
NV_PRESERVE=0
grep -qhE '^[[:space:]]*MODULES[+]?=\(.*nvidia' /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf 2>/dev/null \
    && NV_EARLY=1
# grep without -q on purpose: with -q it stops at the first match, modprobe dies
# of SIGPIPE on the other end, and pipefail then reports the pipeline as failed
# even though the match was found.
modprobe --showconfig 2>/dev/null \
    | grep -E '^options[[:space:]]+nvidia[[:space:]].*NVreg_PreserveVideoMemoryAllocations=1([[:space:]]|$)' \
    >/dev/null && NV_PRESERVE=1

if [ "$NV_EARLY" -eq 1 ] && [ "$NV_PRESERVE" -eq 1 ]; then
    warn "the nvidia module is loaded in the initramfs and told to preserve video memory"
    dim "hibernating will work; resuming will read the whole image and then throw it away."
    dim ""
    dim "take the preserve away — the open driver does not need it, it already"
    dim "preserves video memory through NVreg_UseKernelSuspendNotifiers:"
    dim "  hibernate-setup --fix-nvidia      # then reboot"
    dim ""
    dim "that shadows gpu-screen-recorder's /usr/lib/modprobe.d/gsr-nvidia.conf"
    dim "with an /etc one saying =0, rebuilds the initramfs, and checks that"
    dim "modprobe really stopped resolving =1 before calling it done."
    dim ""
    dim "GRUB was left alone. If a previous run already wrote resume= into it,"
    dim "take it back out until this passes:  hibernate-setup --revert"
    exit 1
fi
[ "$NV_PRESERVE" -eq 1 ] && dim "nvidia      preserving video memory, but not loaded early — fine"

# ─── where the kernel has to look ────────────────────────────────────────────
if [ "$DRY" -eq 1 ] && [ ! -f "$SWAPFILE" ]; then
    dim "would compute resume_offset once the swapfile exists"
    OFFSET="<computed after creation>"
else
    OFFSET="$(btrfs inspect-internal map-swapfile -r "$SWAPFILE" 2>/dev/null)"
    [ -n "$OFFSET" ] || die "could not read the physical offset of $SWAPFILE"
    dim "resume_offset $OFFSET"
fi

RESUME="resume=UUID=$UUID resume_offset=$OFFSET"

GRUBDEF=/etc/default/grub
[ -f "$GRUBDEF" ] || die "no $GRUBDEF — this script only knows GRUB"

if grep -q 'resume=' "$GRUBDEF"; then
    ok "GRUB already carries a resume= parameter"
    dim "$(grep -n 'resume=' "$GRUBDEF" | head -1)"
    dim "check it matches:  $RESUME"
else
    # Which quote character the line actually uses. Arch's own default is double,
    # CachyOS ships single, and a sed that assumes either one silently matches
    # nothing on the other -- which is exactly what happened the first time.
    Q="$(sed -nE "s/^GRUB_CMDLINE_LINUX_DEFAULT=([\"']).*/\\1/p" "$GRUBDEF" | head -1)"
    [ -n "$Q" ] || die "cannot tell how GRUB_CMDLINE_LINUX_DEFAULT is quoted in $GRUBDEF"

    run cp -a "$GRUBDEF" "$GRUBDEF.bak.$(date +%Y%m%d-%H%M%S)"
    if [ "$DRY" -eq 1 ]; then
        dim "would append to GRUB_CMDLINE_LINUX_DEFAULT ($Q-quoted): $RESUME"
    else
        # Appended inside the existing quotes rather than replacing the line, so
        # nothing already on the command line is lost.
        sed -i "s|^\(GRUB_CMDLINE_LINUX_DEFAULT=${Q}[^${Q}]*\)${Q}|\1 ${RESUME}${Q}|" "$GRUBDEF" \
            || die "could not edit $GRUBDEF"
        grep -q "resume=UUID=$UUID" "$GRUBDEF" \
            || die "the edit to $GRUBDEF did not take — check it by hand"
    fi
    ok "added resume= to $GRUBDEF"
fi

if [ "$DRY" -eq 1 ]; then
    dim "would regenerate /boot/grub/grub.cfg"
else
    run cp -a /boot/grub/grub.cfg "/boot/grub/grub.cfg.bak.$(date +%Y%m%d-%H%M%S)" 2>/dev/null
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || die "grub-mkconfig failed"
    grep -q "resume=UUID=$UUID" /boot/grub/grub.cfg \
        || die "grub.cfg came out without resume= — do NOT reboot, check $GRUBDEF"
    ok "regenerated /boot/grub/grub.cfg"
fi

# ─── the initramfs has to be able to act on it ───────────────────────────────
# With the `systemd` hook, resuming is systemd-hibernate-resume-generator's job
# and it reads resume= off the command line by itself — there is no `resume` hook
# to add. Without that hook the classic one would be needed, so it is checked
# rather than assumed.
if grep -qE '^HOOKS=.*\bsystemd\b' /etc/mkinitcpio.conf 2>/dev/null; then
    ok "mkinitcpio uses the systemd hook — resume is handled by systemd"
elif grep -qE '^HOOKS=.*\bresume\b' /etc/mkinitcpio.conf 2>/dev/null; then
    ok "mkinitcpio carries the resume hook"
else
    warn "mkinitcpio has neither the systemd nor the resume hook"
    dim "add 'resume' to HOOKS in /etc/mkinitcpio.conf, after 'filesystems',"
    dim "then: mkinitcpio -P"
fi

printf '\n'
if [ "$DRY" -eq 1 ]; then
    dim "dry run — nothing was written"
    exit 0
fi

ok "done — reboot, then check it took:"
dim "  swapon --show                 # the swapfile, priority -2, next to zram"
dim "  cat /sys/power/resume         # a device, not 0:0"
dim "  systemctl hibernate           # the real test"
