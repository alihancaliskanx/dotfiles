// niri — scrollable-tiling Wayland compositor
//
// Translated from hyprland.conf; same key layout, same rainynight colours, same
// helper programs (waybar, mako, fuzzel, swayosd, hypridle, hyprlock).
//
// Differences from Hyprland are marked below with "// DIFF:".
// To validate it:  niri validate -c ~/.config/niri/config.kdl

input {
    keyboard {
        xkb {
            layout "tr"
        }
        // Defaults feel sluggish when holding a key.
        repeat-delay 250
        repeat-rate 40
    }

    touchpad {
        tap
        natural-scroll
    }

    // hyprland.conf: follow_mouse = 1
    focus-follows-mouse
}

// hyprland.conf: monitor = , preferred, auto, 1
// niri detects connected outputs by itself; if you need custom settings:
//   output "eDP-1" { mode "1920x1080@60"; scale 1; position x=0 y=0 }

layout {
    // hyprland.conf: gaps_in = 5, gaps_out = 10
    gaps 10

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // hyprland.conf: border_size = 2, col.active_border / col.inactive_border
    focus-ring {
        width 2
        active-color "#303463"
        inactive-color "#1e2030"
    }

    border {
        off
    }

    // hyprland.conf: decoration { shadow { enabled = false } }
    shadow {
        off
    }
}

// hyprland.conf: misc { background_color = rgb(101010) }
// The backdrop is what Mod+Q / Mod+S uncover: the surface the workspaces float
// on in the overview. Deliberately NOT the wallpaper — a `layer-rule` with
// place-within-backdrop would move hyprpaper's layer into the backdrop, and
// then the wallpaper is only ever seen in the overview and the desktop itself
// goes flat. Wallpaper on the desktop, dark navy behind the overview.
overview {
    backdrop-color "#1e2030"
}

// DIFF: no workspace declarations. Hyprland keeps ten workspaces whether or
// not anything is on them; niri's strip is dynamic — a workspace exists while
// it is used and disappears when it empties, with one spare always parked at
// the end. Ten named workspaces were tried to pin 1-9/0 in place, but a named
// workspace exists even while empty, so ten of them plus niri's spare meant
// eleven entries in the overview and no setting hides the last one. The
// bindings below address workspaces by index instead.

// ─── environment variables ───────────────────────────────────────────────────
environment {
    XCURSOR_SIZE "24"
    XCURSOR_THEME "Adwaita"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORMTHEME "kde"
    XDG_CURRENT_DESKTOP "niri:KDE"
    XDG_MENU_PREFIX "plasma-"
    FILEMANAGER "nautilus"
    // DIFF: AQ_DRM_DEVICES is specific to Hyprland's aquamarine backend, absent in niri.
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// ─── run at startup ──────────────────────────────────────────────────────────
// The equivalent of the exec-once lines in hyprland.conf.
spawn-at-startup "systemctl" "--user" "start" "hyprpolkitagent"
spawn-at-startup "systemctl" "--user" "start" "waybar"
// Keeps ksycoca fresh so Dolphin's "Open With" does not empty out — see the
// same line in hyprland.conf.
spawn-at-startup "kded6"
// The systemd --user manager never learns XDG_SESSION_CLASS on its own, so
// units gated on it are skipped forever — localsearch-3.service is one, which
// is why Nautilus's Recent and search come back empty. Same line as
// hyprland.conf.
spawn-at-startup "systemctl" "--user" "import-environment" "XDG_SESSION_CLASS" "XDG_SESSION_TYPE"
// Same wallpaper, same ~/.config/hypr/hyprpaper.conf as Hyprland; the config
// comes from the `desktop` package, which both profiles link.
spawn-at-startup "hyprpaper"
spawn-at-startup "mako"
spawn-at-startup "swayosd-server"
spawn-at-startup "hypridle"
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d-%H%M%S.png"

hotkey-overlay {
    skip-at-startup
}

// ─── window rules ────────────────────────────────────────────────────────────
// hyprland.conf: decoration { rounding = 14 }
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

// Settings dialogs are the wrong shape for tiling.
window-rule {
    match app-id=r#"^(pavucontrol|nm-connection-editor|blueman-manager)$"#
    open-floating true
}

// Picture-in-Picture floats, small, out of the way.
window-rule {
    match title=r#"^(Picture-in-Picture)$"#
    open-floating true
    default-window-height { fixed 270; }
    default-column-width { fixed 480; }
}

// hyprland.conf: active_opacity = 0.95 / inactive_opacity = 0.90
window-rule {
    match is-active=true
    opacity 0.95
}

window-rule {
    match is-active=false
    opacity 0.90
}

// DIFF: the blur { } block from Hyprland has no equivalent in niri — niri does
// not apply blur. Transparency is kept, blur is not.

animations {
    slowdown 1.0
}

// ─── key bindings ────────────────────────────────────────────────────────────
binds {
    // Mod = Super ($mod in hyprland.conf)

    Mod+Return       { spawn "alacritty"; }
    Alt+Space        { spawn "fuzzel"; }
    Mod+Shift+Space  { spawn "pkill" "-SIGUSR1" "waybar"; }
    Mod+B            { spawn "sh" "-c" "gtk-launch $(xdg-settings get default-web-browser)"; }
    Mod+E            { spawn "sh" "-c" "xdg-open ~"; }
    // Spotify is a flatpak; hyprland.conf carries why this is `flatpak run`
    // and not `gtk-launch com.spotify.Client`.
    Mod+M            { spawn "flatpak" "run" "com.spotify.Client"; }
    Ctrl+Alt+Space   { spawn "claude-desktop"; }
    Mod+W            { close-window; }
    Mod+F            { fullscreen-window; }
    Mod+T            { toggle-window-floating; }
    Mod+L            { spawn "hyprlock"; }
    Mod+Shift+H      { spawn "sh" "-c" r#"[ "$(printf 'No\nYes' | fuzzel --dmenu --prompt 'Quit niri? ' --lines 2)" = Yes ] && niri msg action quit -s"#; }
    Ctrl+Alt+Delete  { spawn "sh" "-c" r#"[ "$(printf 'No\nYes' | fuzzel --dmenu --prompt 'Quit niri? ' --lines 2)" = Yes ] && niri msg action quit -s"#; }
    Mod+V            { spawn "sh" "-c" "cliphist decode \"$(cliphist list | fuzzel --dmenu)\" | wl-copy"; }
    // niri has no force-kill action, so the pid of the focused window is asked
    // for and killed directly. KDE's Meta+Ctrl+Esc.
    Mod+Ctrl+Escape  { spawn "sh" "-c" r#"kill -9 "$(niri msg -j focused-window | jq .pid)""#; }
    Mod+Shift+P      { spawn "sh" "-c" r#"exec "$HOME/.local/bin/power-profile""#; }
    Print            { spawn "sh" "-c" "grim - | satty -f -"; }
    Mod+Shift+S      { spawn "sh" "-c" "grim -g \"$(slurp)\" - | satty -f -"; }
    Mod+Print        { screenshot-window; }

    // ── focus ───────────────────────────────────────────────────────────────
    // DIFF: niri is column based. The plain arrows stay inside the workspace:
    // left and right move between columns, up and down between the windows
    // stacked in one column.
    Mod+Left         { focus-column-left; }
    Mod+Right        { focus-column-right; }
    Mod+Up           { focus-window-up; }
    Mod+Down         { focus-window-down; }

    Mod+Shift+Left   { move-column-left; }
    Mod+Shift+Right  { move-column-right; }
    Mod+Shift+Up     { move-window-up; }
    Mod+Shift+Down   { move-window-down; }

    // KDE walks the desktops with Meta+Ctrl+Arrow and drags the window along
    // with Meta+Ctrl+Shift+Arrow. Its desktops sit in one row, niri stacks its
    // workspaces, so left maps to up and right to down; the vertical arrows do
    // the same thing under their own name.
    Mod+Ctrl+Left    { focus-workspace-up; }
    Mod+Ctrl+Right   { focus-workspace-down; }
    Mod+Ctrl+Up      { focus-workspace-up; }
    Mod+Ctrl+Down    { focus-workspace-down; }

    Mod+Ctrl+Shift+Left  { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+Right { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+Up    { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+Down  { move-column-to-workspace-down; }

    // ── workspaces ──────────────────────────────────────────────────────────
    // By index: a bare number is a position in the strip, and the strip only
    // holds what is in use, so these reach as far as you have gone. The same
    // ten keys as Hyprland, 0 being the tenth.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // hyprland.conf: bind = $mod, mouse_down/up, workspace, e+1 / e-1
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down  { move-workspace-down; }
    Mod+Ctrl+Page_Up    { move-workspace-up; }

    // DIFF: Mod+left click = move window, Mod+right click = resize are built
    // into niri; the bindm lines in hyprland.conf need no config equivalent.

    // ── niri specific: scrollable layout controls ───────────────────────────
    // No Hyprland equivalent, but scrollable tiling is hard to use without them.
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { reset-window-height; }
    Mod+C            { center-column; }
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    Mod+Home         { focus-column-first; }
    Mod+End          { focus-column-last; }

    // ── parity with the Hyprland config ─────────────────────────────────────
    // A tap of Alt+Tab in KDE returns to the last window rather than walking
    // the list, so that is what it does here too; Alt+Shift+Tab keeps the
    // cycling. Mod+Tab lists every window on every workspace through the
    // shared window-switch script.
    Alt+Tab          { focus-window-previous; }
    Alt+Shift+Tab    { focus-window-or-workspace-down; }
    // Routed through sh so $HOME expands: niri's environment block takes
    // literal strings, and the session PATH has no ~/.local/bin in it.
    Mod+Tab          { spawn "sh" "-c" "exec \"$HOME/.local/bin/window-switch\""; }

    // The overview: every workspace and window at a glance. KDE puts it on
    // Meta+Q, which used to close a window here.
    Mod+Q            { toggle-overview; }
    Mod+S            { toggle-overview; }

    // DIFF: no scratchpad. Hyprland's Mod+S / Mod+Shift+Return toss a window
    // onto a special workspace that overlays the current one and pulls back
    // over it. niri has no such thing: the named workspace that stood in for
    // it only ever sat at the end of the strip as one more place to walk to,
    // which is not the same feature, so it and its bindings are gone.

    // DIFF: no `pin` in niri; a floating window belongs to one workspace and
    // cannot be shown on all of them.

    Mod+Shift+C      { center-visible-columns; }
    Mod+U            { focus-window-previous; }

    // Resizing moved off Mod+Ctrl+Arrow, which KDE uses for the desktops.
    Mod+Alt+Left     { set-column-width "-5%"; }
    Mod+Alt+Right    { set-column-width "+5%"; }
    Mod+Alt+Up       { set-window-height "-5%"; }
    Mod+Alt+Down     { set-window-height "+5%"; }

    Mod+Alt+Shift+Left  { swap-window-left; }
    Mod+Alt+Shift+Right { swap-window-right; }

    // A single window to the workspace above or below. focus=true keeps it on
    // screen: the focus travels to the workspace it landed on. Mod+Ctrl+Shift
    // above does the same for the whole column.
    Mod+Alt+Shift+Up    { move-window-to-workspace-up focus=true; }
    Mod+Alt+Shift+Down  { move-window-to-workspace-down focus=true; }

    // DIFF: Hyprland puts monitor focus on Mod+Comma / Mod+Period, but niri
    // already needs those two for consume/expel-window-from-column, which are
    // core to a scrollable layout. Ctrl is added here rather than moving
    // niri's own bindings.
    Mod+Ctrl+Comma        { focus-monitor-left; }
    Mod+Ctrl+Period       { focus-monitor-right; }
    Mod+Ctrl+Shift+Comma  { move-workspace-to-monitor-left; }
    Mod+Ctrl+Shift+Period { move-workspace-to-monitor-right; }
    Mod+Alt+Comma         { move-column-to-monitor-left; }
    Mod+Alt+Period        { move-column-to-monitor-right; }

    // Mod+Comma stacks a window into the column, this lays the stack out as
    // tabs — the windows end up fully on top of each other.
    Mod+Z            { toggle-column-tabbed-display; }
    // Floating windows overlap freely; this jumps between them and the tiling.
    Mod+A            { switch-focus-between-floating-and-tiling; }
    Mod+X            { maximize-column; }
    Mod+Ctrl+F       { expand-column-to-available-width; }
    Mod+Escape       { focus-workspace-previous; }
    Mod+O            { toggle-window-rule-opacity; }
    Mod+F1           { spawn "sh" "-c" "exec \"$HOME/.local/bin/hotkeys\""; }
    Mod+Shift+Home   { move-column-to-first; }
    Mod+Shift+End    { move-column-to-last; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }
    Mod+WheelScrollRight cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft  cooldown-ms=150 { focus-column-left; }
    // Mod+Shift+P is the power profile, as in KDE, so DPMS moved one modifier on.
    Mod+Ctrl+Shift+P { power-off-monitors; }

    // ── media / hardware keys ───────────────────────────────────────────────
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute         allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }
    // Keyboard backlight. Colour and brightness are separate files on the same
    // LED; brightnessctl writes the level without root. Same three keys as
    // hyprland.conf.
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--device=rgb:kbd_backlight" "set" "10%+"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--device=rgb:kbd_backlight" "set" "10%-"; }
    XF86KbdLightOnOff     allow-when-locked=true { spawn "sh" "-c" r#"[ "$(brightnessctl --device=rgb:kbd_backlight get)" -gt 0 ] && brightnessctl --device=rgb:kbd_backlight -s set 0 || brightnessctl --device=rgb:kbd_backlight -r"#; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }

    // The media keys KDE had on the keypad, plus Mod+Space for play/pause.
    Mod+Space             allow-when-locked=true { spawn "playerctl" "play-pause"; }
    Mod+KP_Add            allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    Mod+KP_Subtract       allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    Mod+Ctrl+KP_Add       allow-when-locked=true { spawn "playerctl" "next"; }
    Mod+Ctrl+KP_Subtract  allow-when-locked=true { spawn "playerctl" "previous"; }
}
